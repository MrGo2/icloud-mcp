{
  "name": "icloud-mcp",
  "version": "2.0.0",
  "description": "MCP server for Apple services: Email, Calendar, Contacts, Reminders, Notes, Messages and Safari, via macOS apps (local) or iCloud protocols (cloud)",
  "main": "index.js",
  "bin": {
    "icloud-mcp": "index.js"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node test/security.test.js",
    "test-mode": "USE_TEST_MODE=true node index.js",
    "inspect": "npx @modelcontextprotocol/inspector node index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MrGo2/icloud-mcp.git"
  },
  "homepage": "https://github.com/MrGo2/icloud-mcp#readme",
  "bugs": {
    "url": "https://github.com/MrGo2/icloud-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "icloud",
    "apple",
    "applescript",
    "email",
    "calendar",
    "contacts"
  ],
  "author": "Carlos Lorenzo",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "dotenv": "^16.4.5",
    "ical.js": "^2.1.0",
    "imap": "^0.8.19",
    "mailparser": "^3.7.1",
    "nodemailer": "^6.9.14",
    "tsdav": "^2.1.1",
    "zod": "^4.4.3"
  }
}
